# Excaliflow Cloud — environment variables.
# Copy to `.env` for local dev:  cp .env.example .env
# On Vercel, add these in: Project → Settings → Environment Variables.

# Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=https://xyzcompany.supabase.co

# Supabase service_role key (Project Settings → API → service_role, "secret").
# NEVER expose this to the browser — it stays server-side only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...paste-your-service-role-key...

# Password gate for the cloud API. The app prompts for it once per browser
# session and sends it as the x-cloud-password header. Leave empty to run
# the API open (fine for local dev, NOT for production).
CLOUD_PASSWORD=choose-a-strong-password

# Local dev server port
PORT=3000
